      "signer": "Microsoft",
      "files": ["Listdlls64.exe", "Listdlls.exe"],
      "actions": [
        { "id": "list", "name": "ListDLLs", "target": "process", "run": "console", "args": "{pid}" }
      ]
    },
    {
      // Any other Sysinternals tool: shown under its own description ("Autoruns", "TCPView", ...).
      "id": "sysinternals",
      "name": "Sysinternals",
      "nameFrom": "FileDescription",
      "categories": ["System"],
      "match": { "CompanyName": "*Sysinternals*" },
      "signer": "Microsoft",
      "actions": []
