    {
      "id": "postman",
      "name": "Postman",
      "categories": ["Network"],
      "match": { "ProductName": "Postman" },
      "signer": "Postman",
      "files": ["Postman.exe"],
      "actions": []
    },

    // ---- Inside WSL distros (found per distro; run with "wsl --exec", never through a shell) ----
    {
      "id": "wsl-strings",
      "name": "strings",
      "categories": ["Command-line"],
      "wsl": "strings",
      "actions": [
        { "id": "strings", "name": "strings (8+ chars)", "target": "file", "run": "console", "args": "-n 8 {path}" }
