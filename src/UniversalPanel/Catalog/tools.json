    {
      "id": "pe-sieve",
      "name": "PE-sieve",
      "categories": ["Command-line", "Binary analysis"],
      "match": { "ProductName": "*PE-sieve*" },
      "files": ["pe-sieve64.exe", "pe-sieve32.exe"],
      "actions": [
        { "id": "scan", "name": "PE-sieve (scan for implants)", "target": "process", "run": "console", "args": "/pid {pid}" }
      ]
    },
    {
      "id": "wireshark",
      "name": "Wireshark",
      "categories": ["Network"],
      "match": { "ProductName": "Wireshark" },
      "signer": "Wireshark Foundation",
      "files": ["Wireshark.exe"],
      "actions": []
