// Tools the panel recognizes, and what it can do with them. Adding a tool or changing a default
// argument is a one-file change: see docs/TOOLS.md for every field. Users can change any action
// from the tool's Edit page; their changes are kept separately, so updates here don't overwrite them.
//
// match      How the panel recognizes the file: version-info fields (as shown in the file's
//            Properties > Details), all must match. "*" is a wildcard; matching ignores case.
// signer     If the publisher signs the file: part of the signer's name. A file with this valid
//            signature shows "Verified"; without one, "Identified".
// files      File names "Find installed tools" looks for, preferred first.
// wsl        For tools inside WSL distros: the command name to look for.
// actions    target: "process" (uses {pid}), "file" ({path}, {dir}, {name}), or "none".
//            run:    "window" (a normal app) or "console" (output shown in a console window).
//            args:   placeholders {pid} {path} {dir} {name}. Each argument stays one argument,
//                    spaces and all; nothing is passed through a shell. Quotes are optional.
{
  "tools": [
    {
      "id": "ida",
      "name": "IDA",
      "categories": ["Reverse engineering"],
      "match": { "CompanyName": "Hex-Rays SA", "ProductName": "*Interactive Disassembler*" },
      "files": ["ida64.exe", "ida.exe"],
      "actions": [
        { "id": "open", "name": "Open in IDA", "target": "file", "args": "{path}" }
      ]
    },
    {
      "id": "ghidra",
      "name": "Ghidra",
      "categories": ["Reverse engineering"],
      "detect": "ghidra",
      "files": ["ghidraRun.bat"],
      "actions": []
    },
    {
      "id": "binary-ninja",
      "name": "Binary Ninja",
      "categories": ["Reverse engineering"],
      "match": { "ProductName": "*Binary Ninja*" },
      "signer": "Vector 35",
      "files": ["binaryninja.exe"],
      "actions": [
        { "id": "open", "name": "Open in Binary Ninja", "target": "file", "args": "{path}" }
      ]
    },
    {
      "id": "cutter",
      "name": "Cutter",
      "categories": ["Reverse engineering"],
      "match": { "ProductName": "*Cutter*" },
      "files": ["Cutter.exe"],
      "actions": [
        { "id": "open", "name": "Open in Cutter", "target": "file", "args": "{path}" }
      ]
    },
    {
      "id": "x64dbg",
      "name": "x64dbg",
      "categories": ["Reverse engineering", "Debugging"],
      "match": { "ProductName": "x64dbg" },
      "signer": "Duncan Ogilvie",
      "version": "buildDate",
      "files": ["x96dbg.exe", "x64dbg.exe"],
      "actions": [
        // x96dbg picks the 32- or 64-bit debugger itself (x64dbg_launcher.cpp, "-p PID").
        { "id": "attach", "name": "Attach x64dbg", "target": "process", "args": "-p {pid}" },
        { "id": "open", "name": "Open in x64dbg", "target": "file", "args": "{path}" }
      ]
    },
    {
      "id": "windbg",
      "name": "WinDbg",
      "categories": ["Debugging"],
      "match": { "ProductName": "*WinDbg*" },
      "signer": "Microsoft",
      "files": ["windbg.exe"],
      "actions": [
        { "id": "attach", "name": "Attach WinDbg", "target": "process", "args": "-p {pid}" }
      ]
    },
    {
      "id": "dnspy",
      "name": "dnSpy",
      "categories": ["Reverse engineering", "Debugging", ".NET"],
      "match": { "ProductName": "*dnSpy*" },
      "files": ["dnSpy.exe"],
      "actions": [
        { "id": "open", "name": "Open in dnSpy", "target": "file", "args": "{path}" }
      ]
    },
    {
      "id": "ilspy",
      "name": "ILSpy",
      "categories": ["Reverse engineering", ".NET"],
      "match": { "ProductName": "*ILSpy*" },
      "files": ["ILSpy.exe"],
      "actions": [
        { "id": "open", "name": "Open in ILSpy", "target": "file", "args": "{path}" }
      ]
    },
    {
      "id": "die",
