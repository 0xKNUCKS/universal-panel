<Application
  x:Class="UniversalPanel.App"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  ShutdownMode="OnExplicitShutdown"
>
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ui:ThemesDictionary Theme="Dark" />
        <ui:ControlsDictionary />
      </ResourceDictionary.MergedDictionaries>

      <!-- WPF-UI justifies tooltip text (Controls/ToolTip/ToolTip.xaml), which stretches the
           spaces on every wrapped line; paths and sentences read better left-aligned. -->
      <Style BasedOn="{StaticResource {x:Type ToolTip}}" TargetType="ToolTip">
        <Setter Property="TextBlock.TextAlignment" Value="Left" />
      </Style>
    </ResourceDictionary>
  </Application.Resources>
</Application>
