<UserControl
  x:Class="UniversalPanel.Modules.Tools.ToolsView"
  x:ClassModifier="internal"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Margin="0,0,0,8" Orientation="Horizontal">
      <ui:Button
        Padding="8,4"
        Appearance="Secondary"
        Click="OnAddClick"
        Content="Add"
        Icon="{ui:SymbolIcon Add24}"
        ToolTip="Add a program or script"
      />
      <ui:Button
        x:Name="FindButton"
        Margin="8,0,0,0"
        Padding="8,4"
        Appearance="Secondary"
        Click="OnFindClick"
        Content="Find installed"
        Icon="{ui:SymbolIcon Search24}"
        ToolTip="Look for known tools (IDA, Ghidra, x64dbg, DIE, ...) in Program Files, Documents, Desktop and Downloads"
      />
    </StackPanel>

    <ListBox
      x:Name="ToolList"
      Grid.Row="1"
      HorizontalContentAlignment="Stretch"
      KeyDown="OnListKeyDown"
      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
    >
      <ListBox.ItemContainerStyle>
        <Style BasedOn="{StaticResource {x:Type ListBoxItem}}" TargetType="ListBoxItem">
          <EventSetter Event="MouseLeftButtonUp" Handler="OnItemClick" />
          <Setter Property="ToolTip" Value="{Binding ToolTipText}" />
        </Style>
      </ListBox.ItemContainerStyle>
      <ListBox.ContextMenu>
        <ContextMenu>
          <MenuItem Click="OnOpen" Header="Open" />
          <MenuItem Click="OnRunAsAdmin" Header="Run as administrator" />
          <Separator />
          <MenuItem Click="OnOpenLocation" Header="Open file location" />
          <MenuItem Click="OnCopyPath" Header="Copy path" />
          <Separator />
          <MenuItem Click="OnMoveUp" Header="Move up" />
          <MenuItem Click="OnMoveDown" Header="Move down" />
          <MenuItem Click="OnRemove" Header="Remove" />
        </ContextMenu>
      </ListBox.ContextMenu>
      <ListBox.ItemTemplate>
        <DataTemplate>
          <Grid Margin="0,4" Opacity="{Binding Opacity}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Image
              Width="32"
              Height="32"
              Margin="0,0,12,0"
              VerticalAlignment="Center"
              Source="{Binding Icon}"
            />
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
              <ui:TextBlock FontTypography="BodyStrong" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
              <ui:TextBlock
                Appearance="Secondary"
                FontTypography="Caption"
                Text="{Binding Subtitle}"
                TextTrimming="CharacterEllipsis"
              />
            </StackPanel>
            <StackPanel
              Grid.Column="2"
              Margin="8,0,0,0"
              VerticalAlignment="Center"
              Orientation="Horizontal"
              Visibility="{Binding BadgeVisibility}"
            >
              <ui:SymbolIcon FontSize="16" Foreground="{Binding BadgeBrush}" Symbol="{Binding BadgeSymbol}" />
              <ui:TextBlock
                Margin="4,0,0,0"
                VerticalAlignment="Center"
                Appearance="Secondary"
                FontTypography="Caption"
                Text="{Binding BadgeText}"
              />
            </StackPanel>
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <ui:TextBlock
      x:Name="EmptyHint"
      Grid.Row="1"
      Margin="8,24"
      HorizontalAlignment="Center"
      Appearance="Secondary"
      Text="No tools yet. Add one, or let the panel find the ones you have installed."
      TextAlignment="Center"
      TextWrapping="Wrap"
    />
    <ContentControl x:Name="Spinner" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" />
  </Grid>
</UserControl>
