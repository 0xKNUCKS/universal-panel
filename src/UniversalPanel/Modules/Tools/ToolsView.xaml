<UserControl
  x:Class="UniversalPanel.Modules.Tools.ToolsView"
  x:ClassModifier="internal"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="clr-namespace:UniversalPanel.Modules.Tools"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
>
  <UserControl.Resources>
    <local:SectionExpandedConverter x:Key="SectionExpanded" />
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

    <!--  Labels above edit fields.  -->
    <Style x:Key="FieldLabel" TargetType="TextBlock">
      <Setter Property="Margin" Value="0,10,0,4" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    </Style>

    <!--  A flat, full-width clickable header (collapsible action cards).  -->
    <Style x:Key="CardHeader" TargetType="ToggleButton">
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Border x:Name="Frame" Padding="{TemplateBinding Padding}" Background="Transparent" CornerRadius="6">
              <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Frame" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Selection is an accent outline, hover a faint wash; no filled highlight. The item sets the
         text colors itself: without a Foreground, text falls back to WPF's default black. -->
    <Style x:Key="OutlineItem" TargetType="ListBoxItem">
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Padding" Value="8" />
      <Setter Property="Margin" Value="2" />
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border
              x:Name="Frame"
              Padding="{TemplateBinding Padding}"
              Background="Transparent"
              BorderBrush="Transparent"
              BorderThickness="1.5"
              CornerRadius="6"
            >
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Frame" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Category filter chips. -->
    <Style x:Key="Chip" TargetType="ListBoxItem">
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Margin" Value="0,0,6,6" />
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border
              x:Name="Frame"
              Padding="10,3"
              Background="Transparent"
              BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
              BorderThickness="1"
              CornerRadius="12"
            >
              <ContentPresenter />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Frame" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                <Setter TargetName="Frame" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Plain list box: no chrome of its own, the items draw everything. -->
    <Style x:Key="BareList" TargetType="ListBox">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBox">
            <!-- A background so empty space takes clicks (they clear the selection). -->
            <ScrollViewer
              Background="{TemplateBinding Background}"
              Focusable="False"
              HorizontalScrollBarVisibility="Disabled"
              VerticalScrollBarVisibility="Auto"
            >
              <ItemsPresenter />
            </ScrollViewer>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="ChipList" BasedOn="{StaticResource BareList}" TargetType="ListBox">
      <Setter Property="ItemContainerStyle" Value="{StaticResource Chip}" />
      <Setter Property="ItemsPanel">
        <Setter.Value>
          <ItemsPanelTemplate>
            <WrapPanel />
          </ItemsPanelTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Secondary" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- The row layout used by the Find list. -->
    <DataTemplate x:Key="FoundTemplate">
      <Grid Opacity="{Binding Opacity}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <CheckBox
          MinWidth="0"
          Margin="0,0,8,0"
          VerticalAlignment="Center"
          Click="OnFoundCheckClick"
          IsChecked="{Binding IsChecked, Mode=TwoWay}"
          IsEnabled="{Binding CanAdd}"
        />
        <Image
          RenderOptions.BitmapScalingMode="HighQuality"
          Grid.Column="1"
          Width="32"
          Height="32"
          Margin="0,0,12,0"
          VerticalAlignment="Center"
          Source="{Binding Tool.Icon}"
        />
        <StackPanel Grid.Column="2" VerticalAlignment="Center">
          <TextBlock FontSize="14" FontWeight="SemiBold" Text="{Binding Tool.Name}" TextTrimming="CharacterEllipsis" />
          <TextBlock Style="{StaticResource Secondary}" Text="{Binding Tool.Subtitle}" />
          <TextBlock Style="{StaticResource Secondary}" Text="{Binding Tool.Path}" />
        </StackPanel>
        <StackPanel Grid.Column="3" Margin="8,0,0,0" VerticalAlignment="Center">
          <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Visibility="{Binding Tool.BadgeVisibility}">
            <ui:SymbolIcon FontSize="16" Foreground="{Binding Tool.BadgeBrush}" Symbol="{Binding Tool.BadgeSymbol}" />
            <TextBlock Margin="4,0,0,0" VerticalAlignment="Center" Style="{StaticResource Secondary}" Text="{Binding Tool.BadgeText}" />
          </StackPanel>
          <TextBlock HorizontalAlignment="Right" Style="{StaticResource Secondary}" Text="{Binding Note}" />
        </StackPanel>
      </Grid>
    </DataTemplate>
  </UserControl.Resources>

  <Grid>
    <!-- ===== Main page: tiles ===== -->
    <Grid x:Name="MainPage">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <Grid Grid.Row="0" Margin="0,0,0,8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <ui:TextBox
          x:Name="SearchBox"
          Icon="{ui:SymbolIcon Search24}"
          PlaceholderText="Search tools"
          TextChanged="OnSearchChanged"
        />
        <ui:Button
          x:Name="SectionsToggle"
          Grid.Column="1"
          Margin="8,0,0,0"
          Padding="8,6"
          Click="OnSectionsToggle"
          Icon="{ui:SymbolIcon GroupList24}"
        />
        <ui:Button
          x:Name="AddButton"
          Grid.Column="2"
          Margin="4,0,0,0"
          Padding="8,6"
          Appearance="Secondary"
          Click="OnAddClick"
          Icon="{ui:SymbolIcon Add24}"
          ToolTip="Add tools"
        >
          <ui:Button.ContextMenu>
            <ContextMenu>
              <MenuItem Click="OnAddManually" Header="Add a program…" />
              <MenuItem Click="OnFindClick" Header="Find installed tools" />
            </ContextMenu>
          </ui:Button.ContextMenu>
        </ui:Button>
      </Grid>

      <ListBox
        x:Name="CategoryChips"
        Grid.Row="1"
        Margin="0,0,0,4"
        SelectionChanged="OnCategoryChanged"
        Style="{StaticResource ChipList}"
      />

      <ListBox
        x:Name="ToolList"
        Grid.Row="2"
        ContextMenuOpening="OnContextMenuOpening"
        KeyDown="OnListKeyDown"
        PreviewMouseLeftButtonDown="OnListPreviewMouseDown"
        SelectionMode="Extended"
        Style="{StaticResource BareList}"
      >
        <ListBox.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel Orientation="Horizontal" />
          </ItemsPanelTemplate>
        </ListBox.ItemsPanel>
        <ListBox.GroupStyle>
          <GroupStyle>
            <GroupStyle.ContainerStyle>
              <Style TargetType="GroupItem">
                <Setter Property="Template">
                  <Setter.Value>
                    <ControlTemplate TargetType="GroupItem">
                      <Expander
                        Margin="0,0,0,6"
                        Padding="4"
                        Collapsed="OnSectionCollapsed"
                        Expanded="OnSectionExpanded"
                        IsExpanded="{Binding Name, Mode=OneTime, Converter={StaticResource SectionExpanded}}"
                      >
                        <Expander.Header>
                          <StackPanel Orientation="Horizontal">
                            <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding Name}" />
                            <TextBlock Margin="8,0,0,0" Style="{StaticResource Secondary}" Text="{Binding ItemCount}" />
                          </StackPanel>
                        </Expander.Header>
                        <ItemsPresenter />
                      </Expander>
                    </ControlTemplate>
                  </Setter.Value>
                </Setter>
              </Style>
            </GroupStyle.ContainerStyle>
          </GroupStyle>
        </ListBox.GroupStyle>
        <ListBox.ItemContainerStyle>
          <Style BasedOn="{StaticResource OutlineItem}" TargetType="ListBoxItem">
            <EventSetter Event="MouseDoubleClick" Handler="OnItemDoubleClick" />
            <Setter Property="ToolTip" Value="{Binding Tool.ToolTipText}" />
          </Style>
        </ListBox.ItemContainerStyle>
        <ListBox.ContextMenu>
          <ContextMenu>
            <MenuItem x:Name="OpenItem" Click="OnOpen" Header="Open" />
            <MenuItem x:Name="AdminItem" Click="OnRunAsAdmin" Header="Run as administrator" />
            <Separator />
            <MenuItem x:Name="EditItem" Click="OnEdit" Header="Edit…" />
            <MenuItem x:Name="SectionsMenu" Header="Sections" />
            <Separator />
            <MenuItem x:Name="LocationItem" Click="OnOpenLocation" Header="Open file location" />
            <MenuItem x:Name="CopyItem" Click="OnCopyPath" Header="Copy path" />
            <Separator />
            <MenuItem x:Name="RemoveItem" Click="OnRemove" Header="Remove" />
          </ContextMenu>
        </ListBox.ContextMenu>
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Grid Width="88" Height="112" Opacity="{Binding Tool.Opacity}">
              <StackPanel VerticalAlignment="Top">
                <Image
          RenderOptions.BitmapScalingMode="HighQuality"
                  Width="48"
                  Height="48"
                  Margin="0,4,0,6"
                  HorizontalAlignment="Center"
                  Source="{Binding Tool.Icon}"
                />
                <!-- Up to two lines, so names like "System Informer" fit. -->
                <TextBlock
                  MaxHeight="36"
                  HorizontalAlignment="Center"
                  FontSize="14"
                  FontWeight="SemiBold"
                  LineHeight="18"
                  LineStackingStrategy="BlockLineHeight"
                  Text="{Binding Tool.Name}"
                  TextAlignment="Center"
                  TextTrimming="CharacterEllipsis"
                  TextWrapping="Wrap"
                />
                <TextBlock HorizontalAlignment="Center" Style="{StaticResource Secondary}" Text="{Binding Tool.Version}" />
              </StackPanel>
              <ui:SymbolIcon
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                FontSize="16"
                Foreground="{Binding Tool.BadgeBrush}"
                Symbol="{Binding Tool.BadgeSymbol}"
                Visibility="{Binding Tool.BadgeVisibility}"
              />
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <TextBlock
        x:Name="EmptyHint"
        Grid.Row="2"
        Margin="8,24"
        HorizontalAlignment="Center"
        Style="{StaticResource Secondary}"
        Text="No tools yet. Add one, or let the panel find the ones you have installed."
        TextAlignment="Center"
        TextTrimming="None"
        TextWrapping="Wrap"
      />
      <ContentControl x:Name="Spinner" Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center" />
    </Grid>

    <!-- ===== Find page: pick what to add ===== -->
    <Grid x:Name="FindPage" Visibility="Collapsed">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <Grid Grid.Row="0" Margin="0,0,0,8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <ui:Button
          Padding="6"
          Appearance="Transparent"
          Click="OnFindBack"
          Icon="{ui:SymbolIcon ArrowLeft24}"
          ToolTip="Back"
        />
        <ui:TextBox
          x:Name="FindSearchBox"
          Grid.Column="1"
          Margin="4,0,0,0"
          Icon="{ui:SymbolIcon Search24}"
          PlaceholderText="Search found tools"
          TextChanged="OnFindSearchChanged"
        />
        <ui:Button
          Grid.Column="2"
          Margin="8,0,0,0"
          Appearance="Secondary"
          Click="OnFindBack"
          Content="Cancel"
        />
        <ui:Button
          x:Name="AddFoundButton"
          Grid.Column="3"
          Margin="4,0,0,0"
          Appearance="Primary"
          Click="OnAddFound"
          Content="Add"
        />
      </Grid>

      <Grid Grid.Row="1" Margin="0,0,0,6">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="FindTitle" Margin="2,0,0,0" VerticalAlignment="Center" Style="{StaticResource Secondary}" />
        <ui:Button
          Grid.Column="1"
          Padding="8,4"
          Appearance="Transparent"
          Click="OnFindSelectAll"
          Content="Select all"
          Icon="{ui:SymbolIcon SelectAllOn24}"
          ToolTip="Check every tool shown that isn't added yet"
        />
        <ui:Button
          Grid.Column="2"
          Margin="4,0,0,0"
          Padding="8,4"
          Appearance="Transparent"
          Click="OnFindSelectNone"
          Content="Select none"
          Icon="{ui:SymbolIcon SelectAllOff24}"
          ToolTip="Uncheck every tool shown"
        />
      </Grid>

      <ListBox
        x:Name="FindChips"
        Grid.Row="2"
        Margin="0,0,0,4"
        SelectionChanged="OnFindCategoryChanged"
        Style="{StaticResource ChipList}"
      />

      <ListBox
        x:Name="FoundList"
        Grid.Row="3"
        ItemTemplate="{StaticResource FoundTemplate}"
        KeyDown="OnFoundKeyDown"
        PreviewMouseLeftButtonDown="OnListPreviewMouseDown"
        SelectionMode="Extended"
        Style="{StaticResource BareList}"
      >
        <ListBox.ItemContainerStyle>
          <Style BasedOn="{StaticResource OutlineItem}" TargetType="ListBoxItem">
            <EventSetter Event="MouseLeftButtonUp" Handler="OnFoundClick" />
            <Setter Property="ToolTip" Value="{Binding Tool.ToolTipText}" />
          </Style>
        </ListBox.ItemContainerStyle>
      </ListBox>
      <ContentControl x:Name="FindSpinner" Grid.Row="3" HorizontalAlignment="Center" VerticalAlignment="Center" />
    </Grid>

    <!-- ===== Edit page ===== -->
    <Grid x:Name="EditPage" Visibility="Collapsed">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <Grid Grid.Row="0" Margin="0,0,0,12">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <ui:Button
          Padding="6"
          Appearance="Transparent"
          Click="OnEditCancel"
          Icon="{ui:SymbolIcon ArrowLeft24}"
          ToolTip="Back"
        />
        <TextBlock
          Grid.Column="1"
          Margin="8,0,0,0"
          VerticalAlignment="Center"
          FontSize="14"
          FontWeight="SemiBold"
          Foreground="{DynamicResource TextFillColorPrimaryBrush}"
          Text="Edit tool"
        />
        <ui:Button Grid.Column="2" Appearance="Secondary" Click="OnEditCancel" Content="Cancel" />
        <ui:Button
          Grid.Column="3"
          Margin="4,0,0,0"
          Appearance="Primary"
          Click="OnEditSave"
          Content="Save"
        />
      </Grid>

      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,4,8">
          <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Image
          RenderOptions.BitmapScalingMode="HighQuality" x:Name="EditIcon" Width="48" Height="48" Margin="0,0,12,0" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
              <TextBlock x:Name="EditIdentity" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
              <TextBlock x:Name="EditDetail" Style="{StaticResource Secondary}" TextTrimming="None" TextWrapping="Wrap" />
              <StackPanel Margin="0,6,0,0" Orientation="Horizontal">
                <ui:Button Appearance="Secondary" Click="OnEditPickIcon" Content="Change icon…" />
                <ui:Button Margin="4,0,0,0" Appearance="Secondary" Click="OnEditResetIcon" Content="Default icon" />
              </StackPanel>
            </StackPanel>
          </Grid>

          <TextBlock Margin="0,0,0,4" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="Name" />
          <ui:TextBox x:Name="EditName" Margin="0,0,0,12" />

          <TextBlock Margin="0,0,0,4" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="Path" />
          <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ui:TextBox x:Name="EditPath" TextChanged="OnEditPathChanged" />
            <ui:Button Grid.Column="1" Margin="4,0,0,0" Appearance="Secondary" Click="OnEditBrowsePath" Content="Browse…" />
          </Grid>

          <TextBlock Margin="0,0,0,4" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="Sections" />
          <TextBlock Margin="0,0,0,6" Style="{StaticResource Secondary}" Text="A tool can be in more than one. None checked uses the defaults for that tool." TextTrimming="None" TextWrapping="Wrap" />
          <WrapPanel x:Name="EditSections" />

          <TextBlock Margin="0,16,0,4" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="Actions" />
          <TextBlock
            Margin="0,0,0,8"
            Style="{StaticResource Secondary}"
            Text="Shown in Open with when you right-click a process or a module."
            TextTrimming="None"
            TextWrapping="Wrap"
          />
          <ItemsControl x:Name="EditActions">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border
                  Margin="0,0,0,8"
                  BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                  BorderThickness="1"
                  CornerRadius="6"
                >
                  <StackPanel>
                    <!--  Header: click to collapse / expand; the title follows the Name box.  -->
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <ToggleButton
                        Padding="10,8"
                        HorizontalContentAlignment="Stretch"
                        Cursor="Hand"
                        IsChecked="{Binding IsExpanded, Mode=TwoWay}"
                        Style="{StaticResource CardHeader}"
                        ToolTip="Show or hide the settings of this action"
                      >
                        <StackPanel Orientation="Horizontal">
                          <ui:SymbolIcon x:Name="Chevron" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Symbol="ChevronRight24" />
                          <TextBlock
                            Margin="8,0,0,0"
                            VerticalAlignment="Center"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                            Text="{Binding Title}"
                            TextTrimming="CharacterEllipsis"
                          />
                        </StackPanel>
                      </ToggleButton>
                      <ui:Button
                        Grid.Column="1"
                        Margin="0,6,6,6"
                        Padding="12,6"
                        Appearance="Danger"
                        Click="OnEditRemoveAction"
                        Content="Delete"
                        Icon="{ui:SymbolIcon Delete24}"
                        ToolTip="Delete this action"
                      />
                    </Grid>

                    <StackPanel Margin="10,0,10,10" Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibility}}">
                      <TextBlock Style="{StaticResource FieldLabel}" Text="Name" />
                      <ui:TextBox PlaceholderText="What the menu shows, e.g. Open in IDA" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />

                      <TextBlock Style="{StaticResource FieldLabel}" Text="Runs on" />
                      <ComboBox
                        DisplayMemberPath="Label"
                        ItemsSource="{x:Static local:EditableAction.Targets}"
                        SelectedValue="{Binding Target}"
                        SelectedValuePath="Value"
                      />

                      <TextBlock Style="{StaticResource FieldLabel}" Text="Opens in" />
                      <ComboBox
                        DisplayMemberPath="Label"
                        ItemsSource="{x:Static local:EditableAction.RunModes}"
                        SelectedValue="{Binding Run}"
                        SelectedValuePath="Value"
                      />

                      <TextBlock Style="{StaticResource FieldLabel}" Text="Arguments" />
                      <ui:TextBox
                        x:Name="ArgsBox"
                        FontFamily="Consolas"
                        PlaceholderText="e.g. -p {pid}  or  -n 8 {path}"
                        Text="{Binding Args, UpdateSourceTrigger=PropertyChanged}"
                      />
                      <!--  Placeholders are typed exactly as shown, braces included; these insert them.  -->
                      <StackPanel Margin="0,6,0,0" Orientation="Horizontal">
                        <TextBlock Margin="0,0,6,0" VerticalAlignment="Center" Style="{StaticResource Secondary}" Text="Insert:" />
                        <ItemsControl ItemsSource="{x:Static local:EditableAction.Placeholders}">
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                              <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate>
                              <ui:Button
                                Margin="0,0,4,0"
                                Padding="8,3"
                                Appearance="Secondary"
                                Click="OnInsertPlaceholder"
                                Content="{Binding Value}"
                                FontFamily="Consolas"
                                ToolTip="{Binding Label}"
                              />
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                      <CheckBox
                        Margin="0,6,0,0"
                        Content="Don't quote arguments"
                        IsChecked="{Binding AsTyped}"
                        ToolTip="For tools like CFF Explorer"
                      />

                      <TextBlock Style="{StaticResource FieldLabel}" Text="Preview" />
                      <TextBlock
                        FontFamily="Consolas"
                        Style="{StaticResource Secondary}"
                        Text="{Binding Preview}"
                        TextTrimming="None"
                        TextWrapping="Wrap"
                      />
                    </StackPanel>
                  </StackPanel>
                </Border>
                <DataTemplate.Triggers>
                  <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                    <Setter TargetName="Chevron" Property="Symbol" Value="ChevronDown24" />
                  </DataTrigger>
                </DataTemplate.Triggers>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <StackPanel Orientation="Horizontal">
            <ui:Button Appearance="Secondary" Click="OnEditAddAction" Content="Add action" Icon="{ui:SymbolIcon Add24}" />
            <ui:Button
              x:Name="ResetActionsButton"
              Margin="6,0,0,0"
              Appearance="Secondary"
              Click="OnEditResetActions"
              Content="Reset to defaults"
            />
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </Grid>
</UserControl>
