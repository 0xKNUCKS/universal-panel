<UserControl
  x:Class="UniversalPanel.Modules.Processes.History.HistoryView"
  x:ClassModifier="internal"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  PreviewKeyDown="OnPreviewKeyDown"
>
  <UserControl.Resources>
    <Style x:Key="CellText" BasedOn="{StaticResource DefaultDataGridTextElementStyle}" TargetType="TextBlock">
      <Setter Property="ContextMenu" Value="{x:Null}" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
  </UserControl.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Grid Grid.Row="0" Margin="0,0,0,8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <ui:Button
        Width="36"
        Height="36"
        Margin="0,0,8,0"
        Padding="0"
        Appearance="Transparent"
        Click="OnBackClick"
        Icon="{ui:SymbolIcon ArrowLeft24}"
        ToolTip="Back to all processes (Backspace)"
      />
      <ui:TextBlock Grid.Column="1" VerticalAlignment="Center" FontTypography="BodyStrong" Text="Process history" />
      <ui:Button
        Grid.Column="2"
        Padding="8,4"
        Appearance="Transparent"
        Click="OnClearClick"
        Content="Clear"
        Icon="{ui:SymbolIcon Delete24}"
      />
    </Grid>

    <CheckBox
      x:Name="KeepRecording"
      Grid.Row="1"
      Checked="OnKeepRecordingChanged"
      Content="Keep recording while the panel is hidden"
      ToolTip="One process snapshot per second in the background (about 1-2 ms of CPU per second)"
      Unchecked="OnKeepRecordingChanged"
    />

    <ui:DataGrid
      x:Name="Events"
      Grid.Row="2"
      Margin="0,8,0,0"
      AutoGenerateColumns="False"
      CanUserAddRows="False"
      CanUserDeleteRows="False"
      CanUserReorderColumns="False"
      CanUserResizeRows="False"
      CanUserSortColumns="False"
      EnableRowVirtualization="True"
      FontSize="13"
      GridLinesVisibility="None"
      HeadersVisibility="Column"
      IsReadOnly="True"
      RowHeight="28"
      SelectionMode="Single"
      TextColumnElementStyle="{StaticResource CellText}"
      VirtualizingPanel.IsVirtualizing="True"
      VirtualizingPanel.VirtualizationMode="Recycling"
    >
      <ui:DataGrid.RowStyle>
        <Style BasedOn="{StaticResource DefaultDataGridRowStyle}" TargetType="DataGridRow">
          <Setter Property="ToolTip" Value="{Binding Details}" />
          <Setter Property="ToolTipService.InitialShowDelay" Value="500" />
          <Style.Triggers>
            <DataTrigger Binding="{Binding Started}" Value="True">
              <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Started}" Value="False">
              <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </ui:DataGrid.RowStyle>
      <ui:DataGrid.Columns>
        <DataGridTextColumn Width="76" Binding="{Binding TimeText}" Header="Time" />
        <DataGridTextColumn Width="58" Binding="{Binding Kind}" Header="Event" />
        <DataGridTextColumn Width="*" Binding="{Binding Process}" Header="Process" />
        <DataGridTextColumn Width="*" Binding="{Binding Parent}" Header="Parent" />
      </ui:DataGrid.Columns>
    </ui:DataGrid>

    <ui:TextBlock
      x:Name="Summary"
      Grid.Row="3"
      Margin="2,8,0,0"
      Appearance="Secondary"
      FontTypography="Caption"
      TextTrimming="CharacterEllipsis"
    />
  </Grid>
</UserControl>
