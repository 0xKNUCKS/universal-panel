<UserControl
  x:Class="UniversalPanel.Modules.Processes.Details.ProcessDetailsView"
  x:ClassModifier="internal"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  PreviewKeyDown="OnPreviewKeyDown"
>
  <UserControl.Resources>
    <!--  Same fixes as the process grid: WPF-UI's keyed row style, and no per-cell Copy/Cut/Paste menu.  -->
    <Style x:Key="CellText" BasedOn="{StaticResource DefaultDataGridTextElementStyle}" TargetType="TextBlock">
      <Setter Property="ContextMenu" Value="{x:Null}" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style x:Key="DetailRow" BasedOn="{StaticResource DefaultDataGridRowStyle}" TargetType="DataGridRow">
      <Setter Property="ToolTip" Value="" />
      <Setter Property="ToolTipService.InitialShowDelay" Value="700" />
      <EventSetter Event="ToolTipOpening" Handler="OnRowToolTipOpening" />
    </Style>
  </UserControl.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Grid Grid.Row="0" Margin="0,0,0,8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <ui:Button
        Grid.Column="0"
        Width="36"
        Height="36"
        Margin="0,0,8,0"
        Padding="0"
        VerticalAlignment="Top"
        Appearance="Transparent"
        Click="OnBackClick"
        Icon="{ui:SymbolIcon ArrowLeft24}"
        ToolTip="Back to all processes (Backspace)"
      />
      <StackPanel Grid.Column="1">
        <ui:TextBlock x:Name="ProcessName" FontTypography="BodyStrong" TextTrimming="CharacterEllipsis" />
        <ui:TextBlock
          x:Name="ProcessInfo"
          Appearance="Secondary"
          FontTypography="Caption"
          TextTrimming="CharacterEllipsis"
        />
      </StackPanel>
    </Grid>

    <TabControl x:Name="Tabs" Grid.Row="1" SelectionChanged="OnTabsSelectionChanged">
      <TabItem Header="General">
        <ScrollViewer Margin="0,12,0,0" VerticalScrollBarVisibility="Auto">
          <ItemsControl x:Name="GeneralList" Focusable="False">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid Margin="0,0,0,12">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="104" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <ui:TextBlock
                    Margin="0,1,8,0"
                    VerticalAlignment="Top"
                    Appearance="Secondary"
                    FontTypography="Caption"
                    Text="{Binding Key}"
                  />
                  <!--  Unstyled read-only TextBox: selectable and copyable, but looks like text.  -->
                  <TextBox
                    Grid.Column="1"
                    Padding="0"
                    Background="Transparent"
                    BorderThickness="0"
                    CaretBrush="{DynamicResource TextFillColorPrimaryBrush}"
                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                    IsReadOnly="True"
                    Style="{x:Null}"
                    Text="{Binding Value, Mode=OneWay}"
                    TextWrapping="Wrap"
                  />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Threads">
        <Grid Margin="0,8,0,0">
          <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <ui:DataGrid
            x:Name="ThreadsGrid"
            Grid.Row="0"
            AutoGenerateColumns="False"
            CanUserAddRows="False"
            CanUserDeleteRows="False"
            CanUserReorderColumns="False"
            CanUserResizeRows="False"
            ContextMenuOpening="OnThreadsContextMenuOpening"
            EnableRowVirtualization="True"
            FontSize="13"
            GridLinesVisibility="None"
            HeadersVisibility="Column"
            IsReadOnly="True"
            PreviewKeyDown="OnThreadsKeyDown"
            PreviewMouseRightButtonDown="OnThreadsRightButtonDown"
            RowHeight="28"
            RowStyle="{StaticResource DetailRow}"
            SelectionMode="Single"
            TextColumnElementStyle="{StaticResource CellText}"
            VirtualizingPanel.IsVirtualizing="True"
            VirtualizingPanel.VirtualizationMode="Recycling"
          >
            <ui:DataGrid.ContextMenu>
              <ContextMenu>
                <MenuItem Click="OnSuspendThread" Header="Suspend">
                  <MenuItem.Icon>
                    <ui:SymbolIcon Symbol="Pause24" />
                  </MenuItem.Icon>
                </MenuItem>
                <MenuItem Click="OnResumeThread" Header="Resume">
                  <MenuItem.Icon>
                    <ui:SymbolIcon Symbol="Play24" />
                  </MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem Click="OnEndThread" Header="End thread" InputGestureText="Del">
                  <MenuItem.Icon>
                    <ui:SymbolIcon Symbol="DismissCircle24" />
                  </MenuItem.Icon>
                </MenuItem>
              </ContextMenu>
            </ui:DataGrid.ContextMenu>
            <ui:DataGrid.Columns>
              <DataGridTextColumn Width="72" Binding="{Binding Tid}" Header="TID" SortMemberPath="Tid" />
              <DataGridTextColumn Width="50" Binding="{Binding CpuText}" Header="CPU" SortMemberPath="Cpu" />
              <DataGridTextColumn Width="116" Binding="{Binding State}" Header="State" SortMemberPath="State" />
              <DataGridTextColumn Width="*" MinWidth="90" Binding="{Binding Start}" Header="Start" SortMemberPath="Start" />
            </ui:DataGrid.Columns>
          </ui:DataGrid>
          <!--  Holds a ProgressRing only while loading (see LoadingRing).  -->
          <ContentControl
            x:Name="ThreadsSpinner"
            Grid.Row="0"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Focusable="False"
            IsHitTestVisible="False"
          />
          <ui:TextBlock
            x:Name="ThreadsSummary"
            Grid.Row="1"
            Margin="2,8,0,0"
            Appearance="Secondary"
            FontTypography="Caption"
          />
        </Grid>
      </TabItem>

      <TabItem Header="Modules">
        <Grid Margin="0,8,0,0">
          <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <ui:DataGrid
            x:Name="ModulesGrid"
            Grid.Row="0"
            AutoGenerateColumns="False"
            CanUserAddRows="False"
            CanUserDeleteRows="False"
            CanUserReorderColumns="False"
            CanUserResizeRows="False"
            ContextMenuOpening="OnModulesContextMenuOpening"
            EnableRowVirtualization="True"
            FontSize="13"
            GridLinesVisibility="None"
            HeadersVisibility="Column"
            IsReadOnly="True"
            PreviewMouseRightButtonDown="OnModulesRightButtonDown"
            RowHeight="28"
            SelectionMode="Single"
            TextColumnElementStyle="{StaticResource CellText}"
            VirtualizingPanel.IsVirtualizing="True"
            VirtualizingPanel.VirtualizationMode="Recycling"
          >
            <ui:DataGrid.RowStyle>
              <Style BasedOn="{StaticResource DetailRow}" TargetType="DataGridRow">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Flagged}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </ui:DataGrid.RowStyle>
            <ui:DataGrid.ContextMenu>
              <ContextMenu>
                <MenuItem Click="OnModuleOpenLocation" Header="Open file location">
                  <MenuItem.Icon>
                    <ui:SymbolIcon Symbol="FolderOpen24" />
                  </MenuItem.Icon>
                </MenuItem>
                <MenuItem Click="OnModuleCopyPath" Header="Copy path">
                  <MenuItem.Icon>
                    <ui:SymbolIcon Symbol="Copy24" />
                  </MenuItem.Icon>
                </MenuItem>
                <MenuItem Click="OnModuleCopyBase" Header="Copy base address">
                  <MenuItem.Icon>
                    <ui:SymbolIcon Symbol="Copy24" />
                  </MenuItem.Icon>
                </MenuItem>
              </ContextMenu>
            </ui:DataGrid.ContextMenu>
            <ui:DataGrid.Columns>
              <DataGridTextColumn Width="*" Binding="{Binding Name}" Header="Name" SortMemberPath="Name" />
              <DataGridTextColumn Width="140" Binding="{Binding BaseText}" Header="Base" SortMemberPath="BaseAddress" />
              <DataGridTextColumn Width="84" Binding="{Binding SizeText}" Header="Size" SortMemberPath="Size" />
              <DataGridTextColumn Width="130" Binding="{Binding SignerText}" Header="Signer" SortMemberPath="SignerText" />
            </ui:DataGrid.Columns>
          </ui:DataGrid>
          <!--  Holds a ProgressRing only while loading (see LoadingRing).  -->
          <ContentControl
            x:Name="ModulesSpinner"
            Grid.Row="0"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Focusable="False"
            IsHitTestVisible="False"
          />
          <Grid Grid.Row="1" Margin="2,8,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ui:TextBlock
              x:Name="ModulesSummary"
              VerticalAlignment="Center"
              Appearance="Secondary"
              FontTypography="Caption"
              TextWrapping="Wrap"
            />
            <ui:Button
              Grid.Column="1"
              Padding="8,4"
              Appearance="Transparent"
              Click="OnRefreshModules"
              Content="Refresh"
              Icon="{ui:SymbolIcon ArrowClockwise24}"
            />
          </Grid>
        </Grid>
      </TabItem>

      <TabItem x:Name="HandlesTab" Header="Handles">
        <Grid Margin="0,8,0,0">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ui:TextBox
              x:Name="HandleSearch"
              ClearButtonEnabled="True"
              Icon="{ui:SymbolIcon Search24}"
              PlaceholderText="Filter by type or name"
              TextChanged="OnHandleFilterChanged"
            />
            <CheckBox
              x:Name="HideUnnamed"
              Grid.Column="1"
              Margin="8,0,0,0"
              Checked="OnHandleFilterChanged"
              Content="Hide unnamed"
              IsChecked="True"
              Unchecked="OnHandleFilterChanged"
            />
          </Grid>
          <ui:DataGrid
            x:Name="HandlesGrid"
            Grid.Row="1"
            Margin="0,8,0,0"
            AutoGenerateColumns="False"
            CanUserAddRows="False"
            CanUserDeleteRows="False"
            CanUserReorderColumns="False"
            CanUserResizeRows="False"
            ContextMenuOpening="OnHandlesContextMenuOpening"
            EnableRowVirtualization="True"
            FontSize="13"
            GridLinesVisibility="None"
            HeadersVisibility="Column"
            IsReadOnly="True"
            PreviewKeyDown="OnHandlesKeyDown"
            PreviewMouseRightButtonDown="OnHandlesRightButtonDown"
            RowHeight="28"
            RowStyle="{StaticResource DetailRow}"
            SelectionMode="Single"
            TextColumnElementStyle="{StaticResource CellText}"
            VirtualizingPanel.IsVirtualizing="True"
            VirtualizingPanel.VirtualizationMode="Recycling"
          >
            <ui:DataGrid.ContextMenu>
              <ContextMenu>
                <MenuItem Click="OnCopyHandleName" Header="Copy name">
                  <MenuItem.Icon>
                    <ui:SymbolIcon Symbol="Copy24" />
                  </MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem Click="OnCloseHandle" Header="Close handle" InputGestureText="Del">
                  <MenuItem.Icon>
                    <ui:SymbolIcon Symbol="DismissCircle24" />
                  </MenuItem.Icon>
                </MenuItem>
              </ContextMenu>
            </ui:DataGrid.ContextMenu>
            <ui:DataGrid.Columns>
              <DataGridTextColumn Width="96" Binding="{Binding Type}" Header="Type" SortMemberPath="Type" />
              <DataGridTextColumn Width="*" Binding="{Binding Name}" Header="Name" SortMemberPath="Name" />
              <DataGridTextColumn Width="76" Binding="{Binding ValueText}" Header="Handle" SortMemberPath="Value" />
            </ui:DataGrid.Columns>
          </ui:DataGrid>
          <!--  Holds a ProgressRing only while loading (see LoadingRing).  -->
          <ContentControl
            x:Name="HandlesSpinner"
            Grid.Row="1"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Focusable="False"
            IsHitTestVisible="False"
          />
          <Grid Grid.Row="2" Margin="2,8,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ui:TextBlock
              x:Name="HandlesSummary"
              VerticalAlignment="Center"
              Appearance="Secondary"
              FontTypography="Caption"
              TextWrapping="Wrap"
            />
            <ui:Button
              Grid.Column="1"
              Padding="8,4"
              Appearance="Transparent"
              Click="OnRefreshHandles"
              Content="Refresh"
              Icon="{ui:SymbolIcon ArrowClockwise24}"
            />
          </Grid>
        </Grid>
      </TabItem>

      <TabItem x:Name="MemoryTab" Header="Memory">
        <Grid Margin="0,8,0,0">
          <Grid x:Name="MemoryListPanel">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Orientation="Horizontal">
              <CheckBox
                x:Name="OnlySuspicious"
                Checked="OnMemoryFilterChanged"
                Content="Only suspicious"
                ToolTip="Executable memory with no image file behind it, or RWX"
                Unchecked="OnMemoryFilterChanged"
              />
              <CheckBox
                x:Name="ShowReserved"
                Margin="16,0,0,0"
                Checked="OnMemoryFilterChanged"
                Content="Show reserved"
                Unchecked="OnMemoryFilterChanged"
              />
            </StackPanel>
            <ui:DataGrid
              x:Name="MemoryGrid"
              Grid.Row="1"
              Margin="0,8,0,0"
              AutoGenerateColumns="False"
              CanUserAddRows="False"
              CanUserDeleteRows="False"
              CanUserReorderColumns="False"
              CanUserResizeRows="False"
              ContextMenuOpening="OnMemoryContextMenuOpening"
              EnableRowVirtualization="True"
              FontSize="13"
              GridLinesVisibility="None"
              HeadersVisibility="Column"
              IsReadOnly="True"
              PreviewMouseRightButtonDown="OnMemoryRightButtonDown"
              RowHeight="28"
              SelectionMode="Single"
              TextColumnElementStyle="{StaticResource CellText}"
              VirtualizingPanel.IsVirtualizing="True"
              VirtualizingPanel.VirtualizationMode="Recycling"
            >
              <ui:DataGrid.RowStyle>
                <Style BasedOn="{StaticResource DetailRow}" TargetType="DataGridRow">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding Suspicious}" Value="True">
                      <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </ui:DataGrid.RowStyle>
              <ui:DataGrid.ContextMenu>
                <ContextMenu>
                  <MenuItem x:Name="DumpRegionItem" Click="OnDumpRegion" Header="Save region to file">
                    <MenuItem.Icon>
                      <ui:SymbolIcon Symbol="Save24" />
                    </MenuItem.Icon>
                  </MenuItem>
                  <MenuItem x:Name="StringsItem" Click="OnFindStrings" Header="Find strings">
                  <MenuItem.Icon>
                    <ui:SymbolIcon Symbol="TextQuote24" />
                  </MenuItem.Icon>
                </MenuItem>
                <MenuItem Click="OnCopyRegionAddress" Header="Copy address">
                    <MenuItem.Icon>
                      <ui:SymbolIcon Symbol="Copy24" />
                    </MenuItem.Icon>
                  </MenuItem>
                </ContextMenu>
              </ui:DataGrid.ContextMenu>
              <ui:DataGrid.Columns>
                <DataGridTextColumn Width="128" Binding="{Binding BaseText}" Header="Base" SortMemberPath="Base" />
                <DataGridTextColumn Width="78" Binding="{Binding SizeText}" Header="Size" SortMemberPath="Size" />
                <DataGridTextColumn Width="58" Binding="{Binding Protection}" Header="Prot" SortMemberPath="Protection" />
                <DataGridTextColumn Width="62" Binding="{Binding Type}" Header="Type" SortMemberPath="Type" />
                <DataGridTextColumn Width="*" Binding="{Binding Use}" Header="Use" SortMemberPath="Use" />
              </ui:DataGrid.Columns>
            </ui:DataGrid>
            <!--  Holds a ProgressRing only while loading (see LoadingRing).  -->
            <ContentControl
              x:Name="MemorySpinner"
              Grid.Row="1"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Focusable="False"
              IsHitTestVisible="False"
            />
            <Grid Grid.Row="2" Margin="2,8,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <ui:TextBlock
                x:Name="MemorySummary"
                VerticalAlignment="Center"
                Appearance="Secondary"
                FontTypography="Caption"
                TextWrapping="Wrap"
              />
              <ui:Button
                Grid.Column="1"
                Padding="8,4"
                Appearance="Transparent"
                Click="OnRefreshMemory"
                Content="Refresh"
                Icon="{ui:SymbolIcon ArrowClockwise24}"
              />
            </Grid>
                  </Grid>

          <Grid x:Name="StringsPanel" Visibility="Collapsed">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Orientation="Horizontal">
              <ui:Button
                Width="32"
                Height="32"
                Margin="0,0,8,0"
                Padding="0"
                Appearance="Transparent"
                Click="OnStringsBack"
                Icon="{ui:SymbolIcon ArrowLeft24}"
                ToolTip="Back to regions"
              />
              <ui:TextBlock x:Name="StringsTitle" VerticalAlignment="Center" FontTypography="BodyStrong" />
            </StackPanel>
            <ui:TextBox
              x:Name="StringSearch"
              Grid.Row="1"
              Margin="0,8,0,0"
              ClearButtonEnabled="True"
              Icon="{ui:SymbolIcon Search24}"
              PlaceholderText="Filter strings"
              TextChanged="OnStringFilterChanged"
            />
            <ui:DataGrid
              x:Name="StringsGrid"
              Grid.Row="2"
              Margin="0,8,0,0"
              AutoGenerateColumns="False"
              CanUserAddRows="False"
              CanUserDeleteRows="False"
              CanUserReorderColumns="False"
              CanUserResizeRows="False"
              ContextMenuOpening="OnStringsContextMenuOpening"
              EnableRowVirtualization="True"
              FontSize="13"
              GridLinesVisibility="None"
              HeadersVisibility="Column"
              IsReadOnly="True"
              PreviewMouseRightButtonDown="OnStringsRightButtonDown"
              RowHeight="28"
              RowStyle="{StaticResource DefaultDataGridRowStyle}"
              SelectionMode="Single"
              TextColumnElementStyle="{StaticResource CellText}"
              VirtualizingPanel.IsVirtualizing="True"
              VirtualizingPanel.VirtualizationMode="Recycling"
            >
              <ui:DataGrid.ContextMenu>
                <ContextMenu>
                  <MenuItem Click="OnCopyString" Header="Copy string">
                    <MenuItem.Icon>
                      <ui:SymbolIcon Symbol="Copy24" />
                    </MenuItem.Icon>
                  </MenuItem>
                  <MenuItem Click="OnCopyStringAddress" Header="Copy address" />
                </ContextMenu>
              </ui:DataGrid.ContextMenu>
              <ui:DataGrid.Columns>
                <DataGridTextColumn Width="128" Binding="{Binding AddressText}" Header="Address" SortMemberPath="Source.Address" />
                <DataGridTextColumn Width="62" Binding="{Binding Encoding}" Header="Enc" SortMemberPath="Encoding" />
                <DataGridTextColumn Width="*" Binding="{Binding Text}" Header="String" SortMemberPath="Text" />
              </ui:DataGrid.Columns>
            </ui:DataGrid>
            <ContentControl
              x:Name="StringsSpinner"
              Grid.Row="2"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Focusable="False"
              IsHitTestVisible="False"
            />
            <ui:TextBlock
              x:Name="StringsSummary"
              Grid.Row="3"
              Margin="2,8,0,0"
              Appearance="Secondary"
              FontTypography="Caption"
              TextTrimming="CharacterEllipsis"
            />
          </Grid>
        </Grid>
      </TabItem>
    </TabControl>
  </Grid>
</UserControl>
