<UserControl
  x:Class="UniversalPanel.Modules.Processes.Find.FindView"
  x:ClassModifier="internal"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  PreviewKeyDown="OnPreviewKeyDown"
>
  <UserControl.Resources>
    <!--  Same fixes as the other grids: WPF-UI's keyed row style, no per-cell Copy/Cut/Paste menu, ellipsis.  -->
    <Style x:Key="CellText" BasedOn="{StaticResource DefaultDataGridTextElementStyle}" TargetType="TextBlock">
      <Setter Property="ContextMenu" Value="{x:Null}" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style x:Key="ResultRow" BasedOn="{StaticResource DefaultDataGridRowStyle}" TargetType="DataGridRow">
      <Setter Property="ToolTip" Value="{Binding Details}" />
      <Setter Property="ToolTipService.InitialShowDelay" Value="700" />
    </Style>
  </UserControl.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Grid Grid.Row="0" Margin="0,0,0,8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <ui:Button
        Width="36"
        Height="36"
        Margin="0,0,8,0"
        Padding="0"
        Appearance="Transparent"
        Click="OnBackClick"
        Icon="{ui:SymbolIcon ArrowLeft24}"
        ToolTip="Back to all processes (Backspace)"
      />
      <ui:TextBlock
        Grid.Column="1"
        VerticalAlignment="Center"
        FontTypography="BodyStrong"
        Text="Find handles or DLLs"
      />
    </Grid>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <ui:TextBox
        x:Name="Query"
        ClearButtonEnabled="True"
        Icon="{ui:SymbolIcon Search24}"
        KeyDown="OnQueryKeyDown"
        PlaceholderText="Part of a file, key, object or DLL name"
      />
      <ui:Button
        Grid.Column="1"
        Margin="8,0,0,0"
        Appearance="Primary"
        Click="OnFindClick"
        Content="Find"
      />
    </Grid>

    <ui:DataGrid
      x:Name="Results"
      Grid.Row="2"
      Margin="0,8,0,0"
      AutoGenerateColumns="False"
      CanUserAddRows="False"
      CanUserDeleteRows="False"
      CanUserReorderColumns="False"
      CanUserResizeRows="False"
      ContextMenuOpening="OnResultsContextMenuOpening"
      EnableRowVirtualization="True"
      FontSize="13"
      GridLinesVisibility="None"
      HeadersVisibility="Column"
      IsReadOnly="True"
      MouseDoubleClick="OnResultsDoubleClick"
      PreviewMouseRightButtonDown="OnResultsRightButtonDown"
      RowHeight="28"
      RowStyle="{StaticResource ResultRow}"
      SelectionMode="Single"
      TextColumnElementStyle="{StaticResource CellText}"
      VirtualizingPanel.IsVirtualizing="True"
      VirtualizingPanel.VirtualizationMode="Recycling"
    >
      <ui:DataGrid.ContextMenu>
        <ContextMenu>
          <MenuItem Click="OnGoToProcess" FontWeight="SemiBold" Header="Go to process">
            <MenuItem.Icon>
              <ui:SymbolIcon Symbol="Info24" />
            </MenuItem.Icon>
          </MenuItem>
          <MenuItem Click="OnCopyResultName" Header="Copy name">
            <MenuItem.Icon>
              <ui:SymbolIcon Symbol="Copy24" />
            </MenuItem.Icon>
          </MenuItem>
        </ContextMenu>
      </ui:DataGrid.ContextMenu>
      <ui:DataGrid.Columns>
        <DataGridTextColumn Width="130" Binding="{Binding Process}" Header="Process" SortMemberPath="Process" />
        <DataGridTextColumn Width="76" Binding="{Binding Kind}" Header="Type" SortMemberPath="Kind" />
        <DataGridTextColumn Width="*" Binding="{Binding Name}" Header="Name" SortMemberPath="Name" />
      </ui:DataGrid.Columns>
    </ui:DataGrid>

    <!--  Holds a ProgressRing while searching (see LoadingRing).  -->
    <ContentControl
      x:Name="Spinner"
      Grid.Row="2"
      HorizontalAlignment="Center"
      VerticalAlignment="Center"
      Focusable="False"
      IsHitTestVisible="False"
    />

    <ui:TextBlock
      x:Name="Summary"
      Grid.Row="3"
      Margin="2,8,0,0"
      Appearance="Secondary"
      FontTypography="Caption"
      Text="Searches the handles and loaded modules of every process you can open."
      TextTrimming="CharacterEllipsis"
    />
  </Grid>
</UserControl>
