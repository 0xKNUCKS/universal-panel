<UserControl
  x:Class="UniversalPanel.Modules.Processes.ProcessesView"
  x:ClassModifier="internal"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
>
  <Grid>
    <!--  List page; the details page replaces it (ProcessesView.Details.cs)  -->
    <Grid x:Name="ListPage">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <Grid Grid.Row="0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <ui:TextBox
          x:Name="SearchBox"
          ClearButtonEnabled="True"
          Icon="{ui:SymbolIcon Search24}"
          PlaceholderText="Filter by name or PID"
          TextChanged="OnSearchChanged"
        />
        <ui:Button
          x:Name="TreeToggle"
          Grid.Column="1"
          Width="36"
          Height="36"
          Margin="8,0,0,0"
          Padding="0"
          Appearance="Primary"
          Click="OnTreeToggleClick"
          Icon="{ui:SymbolIcon TextBulletListTree24}"
          ToolTip="Showing the process tree (click for a flat list)"
        />
      </Grid>

      <ui:DataGrid
        x:Name="Grid"
        Grid.Row="1"
        Margin="0,8,0,0"
        AutoGenerateColumns="False"
        CanUserAddRows="False"
        CanUserDeleteRows="False"
        CanUserReorderColumns="False"
        CanUserResizeRows="False"
        ContextMenuOpening="OnGridContextMenuOpening"
        EnableRowVirtualization="True"
        FontSize="13"
        GridLinesVisibility="None"
        RowHeight="28"
        HeadersVisibility="Column"
        IsReadOnly="True"
        MouseDoubleClick="OnGridDoubleClick"
        PreviewKeyDown="OnGridKeyDown"
        PreviewMouseRightButtonDown="OnGridRightButtonDown"
        SelectionMode="Single"
        SelectionUnit="FullRow"
        Sorting="OnSorting"
        VirtualizingPanel.IsVirtualizing="True"
        VirtualizingPanel.VirtualizationMode="Recycling"
      >
        <ui:DataGrid.TextColumnElementStyle>
          <!--  WPF-UI gives every cell TextBlock a Copy/Cut/Paste menu, which would shadow the row menu.  -->
          <Style BasedOn="{StaticResource DefaultDataGridTextElementStyle}" TargetType="TextBlock">
            <Setter Property="ContextMenu" Value="{x:Null}" />
          </Style>
        </ui:DataGrid.TextColumnElementStyle>
        <ui:DataGrid.ContextMenu>
          <ContextMenu>
            <MenuItem Click="OnDetails" FontWeight="SemiBold" Header="Details" InputGestureText="Enter">
              <MenuItem.Icon>
                <ui:SymbolIcon Symbol="Info24" />
              </MenuItem.Icon>
            </MenuItem>
            <Separator />
            <MenuItem Click="OnEndProcess" Header="End process" InputGestureText="Del">
              <MenuItem.Icon>
                <ui:SymbolIcon Symbol="DismissCircle24" />
              </MenuItem.Icon>
            </MenuItem>
            <Separator />
            <MenuItem Click="OnSuspend" Header="Suspend">
              <MenuItem.Icon>
                <ui:SymbolIcon Symbol="Pause24" />
              </MenuItem.Icon>
            </MenuItem>
            <MenuItem Click="OnResume" Header="Resume">
              <MenuItem.Icon>
                <ui:SymbolIcon Symbol="Play24" />
              </MenuItem.Icon>
            </MenuItem>
            <Separator />
            <MenuItem x:Name="OpenLocationItem" Click="OnOpenLocation" Header="Open file location">
              <MenuItem.Icon>
                <ui:SymbolIcon Symbol="FolderOpen24" />
              </MenuItem.Icon>
            </MenuItem>
            <MenuItem x:Name="CopyPathItem" Click="OnCopyPath" Header="Copy path">
              <MenuItem.Icon>
                <ui:SymbolIcon Symbol="Copy24" />
              </MenuItem.Icon>
            </MenuItem>
            <!--  Items are added in ProcessesView.Priority.cs  -->
            <MenuItem x:Name="PriorityMenu" Header="Priority">
              <MenuItem.Icon>
                <ui:SymbolIcon Symbol="TopSpeed24" />
              </MenuItem.Icon>
            </MenuItem>
          </ContextMenu>
        </ui:DataGrid.ContextMenu>
        <ui:DataGrid.RowStyle>
          <!--  WPF-UI keys its row style; basing on the implicit type style would pick WPF's stock white rows.  -->
          <Style BasedOn="{StaticResource DefaultDataGridRowStyle}" TargetType="DataGridRow">
            <!--  Non-null placeholder so ToolTipOpening fires; the text is filled in on open.  -->
            <Setter Property="ToolTip" Value="" />
            <EventSetter Event="ToolTipOpening" Handler="OnRowToolTipOpening" />
            <Setter Property="ToolTipService.InitialShowDelay" Value="700" />
          </Style>
        </ui:DataGrid.RowStyle>
        <ui:DataGrid.Columns>
          <!--  Name with tree indent and expander (ProcessesView.Tree.cs)  -->
          <DataGridTemplateColumn Width="*" Header="Name" SortMemberPath="Name">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <StackPanel Margin="{Binding Indent}" VerticalAlignment="Center" Orientation="Horizontal">
                  <ui:Button
                    Width="18"
                    Height="18"
                    Margin="0,0,2,0"
                    Padding="0"
                    Appearance="Transparent"
                    BorderThickness="0"
                    Click="OnExpanderClick"
                    Focusable="False"
                    Visibility="{Binding ExpanderVisibility}"
                  >
                    <ui:SymbolIcon FontSize="11" Symbol="{Binding ExpanderSymbol}" />
                  </ui:Button>
                  <TextBlock VerticalAlignment="Center" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTextColumn
            Width="62"
            Binding="{Binding Pid}"
            Header="PID"
            SortMemberPath="Pid"
          />
          <DataGridTextColumn
            Width="56"
            Binding="{Binding CpuText}"
            Header="CPU"
            SortMemberPath="Cpu"
          />
          <DataGridTextColumn
            Width="86"
            Binding="{Binding MemoryText}"
            Header="Memory"
            SortMemberPath="PrivateBytes"
          />
        </ui:DataGrid.Columns>
      </ui:DataGrid>

      <ui:TextBlock
        x:Name="Summary"
        Grid.Row="2"
        Margin="2,8,0,0"
        Appearance="Secondary"
        FontTypography="Caption"
      />
    </Grid>
    <ContentControl x:Name="DetailsHost" Focusable="False" Visibility="Collapsed" />
  </Grid>
</UserControl>
