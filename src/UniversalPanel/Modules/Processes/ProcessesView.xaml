<UserControl
  x:Class="UniversalPanel.Modules.Processes.ProcessesView"
  x:ClassModifier="internal"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="clr-namespace:UniversalPanel.Modules.Processes"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
>
  <UserControl.Resources>
    <Style x:Key="HeaderCell" TargetType="Border">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Padding" Value="4,0" />
      <Setter Property="Cursor" Value="Hand" />
      <EventSetter Event="MouseLeftButtonUp" Handler="OnHeaderClick" />
      <Setter Property="TextElement.Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
      <Setter Property="TextElement.FontSize" Value="12" />
      <Style.Resources>
        <Style TargetType="TextBlock">
          <Setter Property="VerticalAlignment" Value="Center" />
          <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
      </Style.Resources>
    </Style>
    <Style x:Key="HeaderSplitter" TargetType="GridSplitter">
      <Setter Property="Width" Value="5" />
      <Setter Property="Margin" Value="-2,6,0,6" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="ResizeBehavior" Value="PreviousAndCurrent" />
      <Setter Property="ResizeDirection" Value="Columns" />
      <Setter Property="Background" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
      <Setter Property="Focusable" Value="False" />
    </Style>
    <Style x:Key="Cell" TargetType="TextBlock">
      <Setter Property="Padding" Value="4,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
  </UserControl.Resources>

  <Grid>
    <!--  List page; the details page replaces it (ProcessesView.Details.cs)  -->
    <Grid x:Name="ListPage">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <Grid Grid.Row="0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <ui:TextBox
          x:Name="SearchBox"
          ClearButtonEnabled="True"
          Icon="{ui:SymbolIcon Search24}"
          PlaceholderText="Filter by name or PID"
          TextChanged="OnSearchChanged"
        />
        <ui:Button
          x:Name="TreeToggle"
          Grid.Column="1"
          Width="36"
          Height="36"
          Margin="8,0,0,0"
          Padding="0"
          Appearance="Primary"
          Click="OnTreeToggleClick"
          Icon="{ui:SymbolIcon TextBulletListTree24}"
          ToolTip="Showing the process tree (click for a flat list)"
        />
        <ui:Button
          Grid.Column="2"
          Width="36"
          Height="36"
          Margin="8,0,0,0"
          Padding="0"
          Appearance="Secondary"
          Click="OnFindClick"
          Icon="{ui:SymbolIcon DocumentSearch24}"
          ToolTip="Find handles or DLLs in all processes"
        />
        <ui:Button
          Grid.Column="3"
          Width="36"
          Height="36"
          Margin="8,0,0,0"
          Padding="0"
          Appearance="Secondary"
          Click="OnHistoryClick"
          Icon="{ui:SymbolIcon History24}"
          ToolTip="Process history (starts and exits)"
        />
        <ui:Button
          Grid.Column="4"
          Width="36"
          Height="36"
          Margin="8,0,0,0"
          Padding="0"
          Appearance="Secondary"
          Cursor="Cross"
          Icon="{ui:SymbolIcon Target24}"
          PreviewMouseLeftButtonDown="OnCrosshairDown"
          PreviewMouseLeftButtonUp="OnCrosshairUp"
          ToolTip="Find window: drag onto any window to select its process"
        />
        <ui:Button
          x:Name="MoreButton"
          Grid.Column="5"
          Width="36"
          Height="36"
          Margin="8,0,0,0"
          Padding="0"
          Appearance="Secondary"
          Click="OnMoreClick"
          Icon="{ui:SymbolIcon MoreHorizontal24}"
          ToolTip="More"
        >
          <ui:Button.ContextMenu>
            <ContextMenu>
              <MenuItem Click="OnStartSuspended" Header="Start a program suspended…">
                <MenuItem.Icon>
                  <ui:SymbolIcon Symbol="Pause24" />
                </MenuItem.Icon>
              </MenuItem>
            </ContextMenu>
          </ui:Button.ContextMenu>
        </ui:Button>
      </Grid>

      <!--  A virtualized ListBox of self-drawing rows, not a DataGrid: a DataGrid row costs ~4-8 ms
            to build, so a collapse that brings ~30 rows into view took ~250 ms. System Informer's
            TreeNew keeps a flat list of visible nodes and paints only the visible rows
            (phlib/treenew.c: PhTnpRestructureNodes, PhTnpPaint); this is the WPF equivalent.  -->
      <Grid Grid.Row="1" Margin="0,8,0,0">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Column header: click sorts, the splitters resize (widths are saved).  -->
        <Grid x:Name="HeaderRow" Height="30" Margin="{Binding HeaderMargin, RelativeSource={RelativeSource AncestorType=UserControl}}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="80" />
            <ColumnDefinition MinWidth="30" Width="{Binding PidWidth, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}" />
            <ColumnDefinition MinWidth="30" Width="{Binding CpuWidth, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}" />
            <ColumnDefinition MinWidth="30" Width="{Binding MemoryWidth, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}" />
          </Grid.ColumnDefinitions>
          <Border Grid.Column="0" Style="{StaticResource HeaderCell}" Tag="Name">
            <TextBlock x:Name="NameHeader" Text="Name" />
          </Border>
          <Border Grid.Column="1" Style="{StaticResource HeaderCell}" Tag="Pid">
            <TextBlock x:Name="PidHeader" Text="PID" />
          </Border>
          <Border Grid.Column="2" Style="{StaticResource HeaderCell}" Tag="Cpu">
            <TextBlock x:Name="CpuHeader" Text="CPU" />
          </Border>
          <Border Grid.Column="3" Style="{StaticResource HeaderCell}" Tag="PrivateBytes">
            <TextBlock x:Name="MemoryHeader" Text="Memory" />
          </Border>
          <GridSplitter Grid.Column="1" Style="{StaticResource HeaderSplitter}" />
          <GridSplitter Grid.Column="2" Style="{StaticResource HeaderSplitter}" />
          <GridSplitter Grid.Column="3" Style="{StaticResource HeaderSplitter}" />
        </Grid>

        <ListBox
          x:Name="Grid"
          Grid.Row="1"
          Background="Transparent"
          BorderThickness="0"
          ContextMenuOpening="OnGridContextMenuOpening"
          FontSize="13"
          HorizontalContentAlignment="Stretch"
          MouseDoubleClick="OnGridDoubleClick"
          PreviewKeyDown="OnGridKeyDown"
          PreviewMouseLeftButtonDown="OnGridLeftButtonDown"
          PreviewMouseRightButtonDown="OnGridRightButtonDown"
          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
          SelectionMode="Single"
          VirtualizingPanel.IsVirtualizing="True"
          VirtualizingPanel.VirtualizationMode="Recycling"
        >
            <ListBox.ContextMenu>
              <ContextMenu>
                <MenuItem Click="OnDetails" FontWeight="SemiBold" Header="Details" InputGestureText="Enter">
                  <MenuItem.Icon>
                    <ui:SymbolIcon Symbol="Info24" />
                  </MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem Click="OnEndProcess" Header="End process" InputGestureText="Del">
                  <MenuItem.Icon>
                    <ui:SymbolIcon Symbol="DismissCircle24" />
                  </MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem Click="OnSuspend" Header="Suspend">
                  <MenuItem.Icon>
                    <ui:SymbolIcon Symbol="Pause24" />
                  </MenuItem.Icon>
                </MenuItem>
                <MenuItem Click="OnResume" Header="Resume">
                  <MenuItem.Icon>
                    <ui:SymbolIcon Symbol="Play24" />
                  </MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem x:Name="OpenLocationItem" Click="OnOpenLocation" Header="Open file location">
                  <MenuItem.Icon>
                    <ui:SymbolIcon Symbol="FolderOpen24" />
                  </MenuItem.Icon>
                </MenuItem>
                <MenuItem x:Name="CopyPathItem" Click="OnCopyPath" Header="Copy path">
                  <MenuItem.Icon>
                    <ui:SymbolIcon Symbol="Copy24" />
                  </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Create dump">
                  <MenuItem.Icon>
                    <ui:SymbolIcon Symbol="Save24" />
                  </MenuItem.Icon>
                  <MenuItem Click="OnFullDump" Header="Full dump" ToolTip="Whole memory, handles and threads; for WinDbg / IDA" />
                  <MenuItem Click="OnMiniDump" Header="Minidump" ToolTip="Threads, modules and data segments only; small" />
                </MenuItem>
                <!--  Items are added in ProcessesView.Priority.cs  -->
                <MenuItem x:Name="PriorityMenu" Header="Priority">
                  <MenuItem.Icon>
                    <ui:SymbolIcon Symbol="TopSpeed24" />
                  </MenuItem.Icon>
                </MenuItem>
              </ContextMenu>
            </ListBox.ContextMenu>
          <ListBox.ItemContainerStyle>
            <Style BasedOn="{StaticResource {x:Type ListBoxItem}}" TargetType="ListBoxItem">
              <Setter Property="Height" Value="28" />
              <Setter Property="MinHeight" Value="0" />
              <Setter Property="Margin" Value="0" />
              <Setter Property="Padding" Value="{Binding RowPadding, RelativeSource={RelativeSource AncestorType=UserControl}}" />
              <!--  Non-null placeholder so ToolTipOpening fires; the text is filled in on open.  -->
              <Setter Property="ToolTip" Value="" />
              <EventSetter Event="ToolTipOpening" Handler="OnRowToolTipOpening" />
              <Setter Property="ToolTipService.InitialShowDelay" Value="700" />
            </Style>
          </ListBox.ItemContainerStyle>
          <ListBox.ItemTemplate>
            <!--  One self-drawing element per row (ProcessRowView.cs), like TreeNew's painted rows.  -->
            <DataTemplate>
              <local:ProcessRowView />
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>

      <!--  Holds a ProgressRing until the first sample fills the list (see LoadingRing).  -->
      <ContentControl
        x:Name="ListSpinner"
        Grid.Row="1"
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        Focusable="False"
        IsHitTestVisible="False"
      />

      <ui:TextBlock
        x:Name="Summary"
        TextTrimming="CharacterEllipsis"
        Grid.Row="2"
        Margin="2,8,0,0"
        Appearance="Secondary"
        FontTypography="Caption"
      />
    </Grid>
    <ContentControl x:Name="DetailsHost" Focusable="False" Visibility="Collapsed" />
    <ContentControl x:Name="FindHost" Focusable="False" Visibility="Collapsed" />
    <ContentControl x:Name="HistoryHost" Focusable="False" Visibility="Collapsed" />
  </Grid>
</UserControl>
